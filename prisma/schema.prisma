generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
    url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  BARISTA
  STAFF
}

enum EmployeeRole {
  BARISTA
  CASHIER
  STAFF
  MANAGER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ProductCategory {
  COFFEE
  MILK_TEA
  FRAPPE
  NON_COFFEE
  FOOD_PASTRY
  COFFEE_BEANS
  MILK
  SYRUP
  CUPS
  LIDS
  STRAWS
  PASTRIES
  ADD_ON
  OTHER_INGREDIENT
  SUPPLY
}

enum ProductSize {
  NOT_APPLICABLE
  SMALL
  MEDIUM
  LARGE
}

enum TemperatureOption {
  NOT_APPLICABLE
  HOT
  ICED
}

enum OrderType {
  DINE_IN
  TAKE_OUT
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum StockLogType {
  STOCK_IN
  STOCK_OUT
  SALE
  ADJUSTMENT
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String?
  role         UserRole  @default(STAFF)
  employee     Employee?
  sales        Sale[]
  stockLogs    StockLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Employee {
  id          Int            @id @default(autoincrement())
  firstName   String
  lastName    String
  role        EmployeeRole
  email       String?        @unique
  phone       String?
  status      EmployeeStatus @default(ACTIVE)
  userId      Int?           @unique
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendances Attendance[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, role])
}

model Product {
  id                Int             @id @default(autoincrement())
  name              String
  category          ProductCategory
  size              ProductSize     @default(NOT_APPLICABLE)
  sku               String          @unique
  barcode           String?         @unique
  priceCents        Int
  stock             Int             @default(0)
  lowStockThreshold Int             @default(5)
  isMenuItem        Boolean         @default(false)
  isIngredient      Boolean         @default(false)
  isActive          Boolean         @default(true)
  saleItems         SaleItem[]
  stockLogs         StockLog[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([category])
  @@index([isActive, isMenuItem])
  @@index([isActive, isIngredient])
}

model Sale {
  id              Int        @id @default(autoincrement())
  receiptNo       String     @unique
  orderType       OrderType
  status          SaleStatus @default(COMPLETED)
  subtotalCents   Int
  totalCents      Int
  amountPaidCents Int
  changeCents     Int
  createdByUserId Int?
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           SaleItem[]
  createdAt       DateTime   @default(now())

  @@index([createdAt])
}

model SaleItem {
  id              Int               @id @default(autoincrement())
  saleId          Int
  sale            Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId       Int?
  product         Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String
  sku             String
  category        ProductCategory
  size            ProductSize       @default(NOT_APPLICABLE)
  temperature     TemperatureOption @default(NOT_APPLICABLE)
  quantity        Int
  unitPriceCents  Int
  addOnsTotalCents Int             @default(0)
  lineTotalCents  Int
  addOnsJson      String?
  stockLogs       StockLog[]
}

model StockLog {
  id            Int          @id @default(autoincrement())
  productId     Int
  product       Product      @relation(fields: [productId], references: [id])
  type          StockLogType
  quantity      Int
  previousStock Int
  newStock      Int
  note          String?
  saleItemId    Int?
  saleItem      SaleItem?    @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  createdByUserId Int?
  createdBy     User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([type, createdAt])
}

model Attendance {
  id         Int              @id @default(autoincrement())
  employeeId Int
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  timeIn     DateTime?
  timeOut    DateTime?
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date, status])
}
